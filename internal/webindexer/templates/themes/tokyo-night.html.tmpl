<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{{.Title}}</title>
    <style>
    :root {
        --bg: #e1e2e7;
        --bg-dark: #d0d5e3;
        --text: #3760bf;
        --muted: #6172b0;
        --comment: #848cb5;
        --rule: rgba(55, 96, 191, 0.12);
        --accent: #7847bd;
        --folder: #b15c00;
        --file: #2e7de9;
        --hover: rgba(46, 125, 233, 0.08);
        color-scheme: light dark;
    }

    @media (prefers-color-scheme: dark) {
        :root {
            --bg: #1a1b26;
            --bg-dark: #16161e;
            --text: #c0caf5;
            --muted: #a9b1d6;
            --comment: #565f89;
            --rule: rgba(192, 202, 245, 0.10);
            --accent: #bb9af7;
            --folder: #ff9e64;
            --file: #7aa2f7;
            --hover: rgba(122, 162, 247, 0.08);
        }
    }

    *, *::before, *::after {
        box-sizing: border-box;
        margin: 0;
        padding: 0;
    }

    html, body {
        min-height: 100%;
    }

    body {
        font-family: ui-sans-serif, system-ui, -apple-system, "Segoe UI", "Helvetica Neue", sans-serif;
        background: var(--bg);
        color: var(--text);
        line-height: 1.45;
        -webkit-font-smoothing: antialiased;
    }

    .top {
        background: var(--bg-dark);
        border-bottom: 1px solid var(--rule);
    }

    .top-inner,
    .list {
        width: min(48rem, calc(100% - 2rem));
        margin: 0 auto;
    }

    .top-inner {
        padding: 1.35rem 0.85rem;
    }

    h1 {
        font-size: 1.05rem;
        font-weight: 650;
        letter-spacing: -0.025em;
    }

    .list {
        padding: 0.65rem 0 4rem;
    }

    a.row {
        display: grid;
        grid-template-columns: minmax(0, 1fr) 7.25rem 8.5rem;
        gap: 0.85rem;
        align-items: center;
        padding: 0.78rem 0.85rem;
        color: inherit;
        text-decoration: none;
        border-bottom: 1px solid var(--rule);
        transition: background-color 120ms ease;
    }

    a.row:hover,
    a.row:focus-visible {
        background: var(--hover);
        outline: none;
    }

    .name {
        display: flex;
        align-items: center;
        gap: 0.7rem;
        min-width: 0;
        font-weight: 550;
        letter-spacing: -0.015em;
    }

    .name span {
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
    }

    .mark {
        width: 0.5rem;
        height: 0.5rem;
        border-radius: 2px;
        background: var(--file);
        flex-shrink: 0;
    }

    a.row.dir .mark {
        background: var(--folder);
    }

    a.row.up .mark {
        background: var(--accent);
    }

    a.row.dir .name,
    a.row.up .name {
        font-weight: 650;
    }

    a.row.up {
        color: var(--accent);
    }

    .size, .date {
        font-family: ui-monospace, "SFMono-Regular", "SF Mono", Menlo, Consolas, monospace;
        font-size: 0.8rem;
        font-variant-numeric: tabular-nums;
        color: var(--comment);
        white-space: nowrap;
    }

    @media (max-width: 720px) {
        .top-inner,
        .list {
            width: min(48rem, calc(100% - 1.25rem));
        }

        a.row {
            grid-template-columns: minmax(0, 1fr) 6.5rem;
        }

        .date {
            display: none;
        }
    }

    @media (prefers-reduced-motion: reduce) {
        *, *::before, *::after {
            transition: none !important;
        }
    }
    </style>
</head>
<body>
    <header class="top">
        <div class="top-inner">
            {{ if .Title }}
            <h1>{{ .Title }}</h1>
            {{ else }}
            <h1>Index</h1>
            {{ end }}
        </div>
    </header>

    <nav class="list">
        {{ if .ParentURL }}
        <a class="row up" href="{{ .ParentURL }}">
            <span class="name">
                <i class="mark" aria-hidden="true"></i>
                <span>{{ .ParentText }}</span>
            </span>
            <span class="size"></span>
            <span class="date"></span>
        </a>
        {{ end }}
        {{ range .Items }}
        <a class="row{{ if .IsDir }} dir{{ end }}" href="{{ .URL }}">
            <span class="name">
                <i class="mark" aria-hidden="true"></i>
                <span>{{ .Name }}</span>
            </span>
            <span class="size">{{ if .Size }}{{ .Size }}{{ else }}—{{ end }}</span>
            <span class="date">{{ if .LastModifiedDate }}{{ .LastModifiedDate }}{{ else if .LastModified }}{{ .LastModified }}{{ else }}—{{ end }}</span>
        </a>
        {{ end }}
    </nav>
</body>
</html>
