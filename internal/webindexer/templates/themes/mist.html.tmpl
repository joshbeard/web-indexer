<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{{.Title}}</title>
    <style>
    :root {
        --bg: #eef3f1;
        --text: #24302c;
        --muted: #6d7b76;
        --line: rgba(36, 48, 44, 0.08);
        --accent: #3f6f62;
        --row-hover: rgba(63, 111, 98, 0.07);
        color-scheme: light dark;
    }

    @media (prefers-color-scheme: dark) {
        :root {
            --bg: #121716;
            --text: #e6eeeb;
            --muted: #9aaba5;
            --line: rgba(230, 238, 235, 0.08);
            --accent: #8fcdc0;
            --row-hover: rgba(143, 205, 192, 0.08);
        }
    }

    *, *::before, *::after {
        box-sizing: border-box;
        margin: 0;
        padding: 0;
    }

    html, body {
        min-height: 100%;
    }

    body {
        font-family: ui-sans-serif, system-ui, -apple-system, "Segoe UI", "Helvetica Neue", sans-serif;
        background: var(--bg);
        color: var(--text);
        line-height: 1.45;
        -webkit-font-smoothing: antialiased;
    }

    .page {
        width: min(40rem, calc(100% - 2.5rem));
        margin: 0 auto;
        padding: 4rem 0 5.5rem;
    }

    header {
        margin-bottom: 2rem;
    }

    h1 {
        font-size: 0.78rem;
        font-weight: 600;
        letter-spacing: 0.16em;
        text-transform: uppercase;
        color: var(--muted);
    }

    nav {
        display: flex;
        flex-direction: column;
    }

    a.row {
        display: flex;
        align-items: baseline;
        justify-content: space-between;
        gap: 1.5rem;
        padding: 0.95rem 0.85rem;
        border-bottom: 1px solid var(--line);
        color: inherit;
        text-decoration: none;
        box-shadow: inset 0 0 0 transparent;
        transition: background-color 140ms ease, box-shadow 140ms ease;
    }

    a.row:first-child {
        border-top: 1px solid var(--line);
    }

    a.row:hover,
    a.row:focus-visible {
        background: var(--row-hover);
        box-shadow: inset 3px 0 0 var(--accent);
        outline: none;
    }

    .name {
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
        min-width: 0;
        font-size: 1.05rem;
        font-weight: 500;
        letter-spacing: -0.025em;
    }

    a.row.dir .name {
        font-weight: 620;
        color: var(--accent);
    }

    a.row.up .name {
        color: var(--muted);
        font-size: 0.92rem;
        font-weight: 550;
    }

    .meta {
        flex-shrink: 0;
        font-family: ui-monospace, "SFMono-Regular", "SF Mono", Menlo, Consolas, monospace;
        font-size: 0.78rem;
        font-variant-numeric: tabular-nums;
        color: var(--muted);
        white-space: nowrap;
    }

    @media (max-width: 640px) {
        .page {
            width: min(40rem, calc(100% - 1.5rem));
            padding-top: 2.25rem;
        }

        a.row {
            flex-direction: column;
            align-items: flex-start;
            gap: 0.25rem;
            padding-top: 0.85rem;
            padding-bottom: 0.85rem;
        }
    }

    @media (prefers-reduced-motion: reduce) {
        *, *::before, *::after {
            transition: none !important;
        }
    }
    </style>
</head>
<body>
    <div class="page">
        <header>
            {{ if .Title }}
            <h1>{{ .Title }}</h1>
            {{ else }}
            <h1>Index</h1>
            {{ end }}
        </header>

        <nav>
            {{ if .ParentURL }}
            <a class="row up" href="{{ .ParentURL }}">
                <span class="name">{{ .ParentText }}</span>
                <span class="meta"></span>
            </a>
            {{ end }}
            {{ range .Items }}
            <a class="row{{ if .IsDir }} dir{{ end }}" href="{{ .URL }}">
                <span class="name">{{ .Name }}{{ if .IsDir }}/{{ end }}</span>
                <span class="meta">{{ if .Size }}{{ .Size }}{{ else }}{{ if .LastModifiedDate }}{{ .LastModifiedDate }}{{ else if .LastModified }}{{ .LastModified }}{{ else }}—{{ end }}{{ end }}</span>
            </a>
            {{ end }}
        </nav>
    </div>
</body>
</html>
