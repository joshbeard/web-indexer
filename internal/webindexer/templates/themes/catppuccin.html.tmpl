<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{{.Title}}</title>
    <style>
    :root {
        --crust: #dce0e8;
        --base: #eff1f5;
        --text: #4c4f69;
        --subtext: #6c6f85;
        --overlay: #9ca0b0;
        --surface: #ccd0da;
        --accent: #8839ef;
        --folder: #fe640b;
        --file: #1e66f5;
        --hover: #e6e9ef;
        color-scheme: light dark;
    }

    @media (prefers-color-scheme: dark) {
        :root {
            --crust: #11111b;
            --base: #1e1e2e;
            --text: #cdd6f4;
            --subtext: #a6adc8;
            --overlay: #6c7086;
            --surface: #313244;
            --accent: #cba6f7;
            --folder: #fab387;
            --file: #89b4fa;
            --hover: #313244;
        }
    }

    *, *::before, *::after {
        box-sizing: border-box;
        margin: 0;
        padding: 0;
    }

    html, body {
        min-height: 100%;
    }

    body {
        font-family: ui-sans-serif, system-ui, -apple-system, "Segoe UI", "Helvetica Neue", sans-serif;
        background: var(--crust);
        color: var(--text);
        line-height: 1.45;
        -webkit-font-smoothing: antialiased;
    }

    .page {
        width: min(46rem, calc(100% - 2rem));
        margin: 0 auto;
        padding: 2.75rem 0 4.5rem;
    }

    h1 {
        font-size: 1.15rem;
        font-weight: 650;
        letter-spacing: -0.03em;
        margin-bottom: 1.15rem;
        padding: 0 0.15rem;
    }

    .panel {
        background: var(--base);
        border: 1px solid var(--surface);
        border-radius: 1rem;
        overflow: hidden;
    }

    .head,
    a.row {
        display: grid;
        grid-template-columns: minmax(0, 1fr) 7.25rem 8.5rem;
        gap: 0.85rem;
        align-items: center;
        padding: 0.78rem 1.05rem;
    }

    .head {
        font-size: 0.7rem;
        font-weight: 650;
        letter-spacing: 0.08em;
        text-transform: uppercase;
        color: var(--overlay);
        border-bottom: 1px solid var(--surface);
    }

    a.row {
        color: inherit;
        text-decoration: none;
        border-bottom: 1px solid var(--surface);
        transition: background-color 120ms ease;
    }

    a.row:last-child {
        border-bottom: none;
    }

    a.row:hover,
    a.row:focus-visible {
        background: var(--hover);
        outline: none;
    }

    .name {
        display: flex;
        align-items: center;
        gap: 0.7rem;
        min-width: 0;
        font-weight: 550;
        letter-spacing: -0.015em;
    }

    .name span {
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
    }

    .mark {
        width: 0.55rem;
        height: 0.55rem;
        border-radius: 50%;
        background: var(--file);
        flex-shrink: 0;
    }

    a.row.dir .mark {
        background: var(--folder);
    }

    a.row.up .mark {
        background: var(--accent);
    }

    a.row.dir .name,
    a.row.up .name {
        font-weight: 650;
    }

    a.row.up {
        color: var(--accent);
        background: color-mix(in srgb, var(--accent) 8%, var(--base));
    }

    .size, .date {
        font-family: ui-monospace, "SFMono-Regular", "SF Mono", Menlo, Consolas, monospace;
        font-size: 0.8rem;
        font-variant-numeric: tabular-nums;
        color: var(--subtext);
        white-space: nowrap;
    }

    @media (max-width: 720px) {
        .page {
            width: min(46rem, calc(100% - 1.25rem));
            padding-top: 1.5rem;
        }

        .head,
        a.row {
            grid-template-columns: minmax(0, 1fr) 6.5rem;
        }

        .date,
        .head span:nth-child(3) {
            display: none;
        }
    }

    @media (prefers-reduced-motion: reduce) {
        *, *::before, *::after {
            transition: none !important;
        }
    }
    </style>
</head>
<body>
    <div class="page">
        {{ if .Title }}
        <h1>{{ .Title }}</h1>
        {{ else }}
        <h1>Index</h1>
        {{ end }}

        <main class="panel">
            <div class="head">
                <span>Name</span>
                <span>Size</span>
                <span>Modified</span>
            </div>
            {{ if .ParentURL }}
            <a class="row up" href="{{ .ParentURL }}">
                <span class="name">
                    <i class="mark" aria-hidden="true"></i>
                    <span>{{ .ParentText }}</span>
                </span>
                <span class="size"></span>
                <span class="date"></span>
            </a>
            {{ end }}
            {{ range .Items }}
            <a class="row{{ if .IsDir }} dir{{ end }}" href="{{ .URL }}">
                <span class="name">
                    <i class="mark" aria-hidden="true"></i>
                    <span>{{ .Name }}</span>
                </span>
                <span class="size">{{ if .Size }}{{ .Size }}{{ else }}—{{ end }}</span>
                <span class="date">{{ if .LastModifiedDate }}{{ .LastModifiedDate }}{{ else if .LastModified }}{{ .LastModified }}{{ else }}—{{ end }}</span>
            </a>
            {{ end }}
        </main>
    </div>
</body>
</html>
